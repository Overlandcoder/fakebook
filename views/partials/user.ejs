<% const { posts, comments, followers, following } = user._count %>
<% const isFollowing = followingIds.some(id => id === user.id) %>

<div class="grid grid-cols-[1fr_auto_1fr] items-center pt-2 px-1 mb-1">
  <div></div>
  <a href="/users/<%= user.username %>" class="text-xl text-center font-bold text-green-600 hover:text-green-500 hover:drop-shadow-[0_0_8px_rgba(34,197,94,0.3)] truncate transition-all"><%= user.username %></a>
  <div class="justify-self-end">
    <% if (currentUser && currentUser.id !== user.id) { %>
      <% const followBtnClasses = "px-3.5 py-1 rounded-lg transition-colors" %>
      <% if (isFollowing) { %>
        <form action="/users/<%= user.username %>/follow?_method=DELETE" method="POST">
          <button type="submit" class="<%= followBtnClasses %> text-sm font-semibold bg-amber-600 text-white hover:bg-red-600 hover:text-white">Unfollow</button>
        </form>
      <% } else { %>
        <form action="/users/<%= user.username %>/follow" method="POST">
          <button type="submit" class="<%= followBtnClasses %> text-sm font-semibold bg-green-600 text-white hover:bg-green-700">Follow</button>
        </form>
      <% } %>
    <% } %>
  </div>
</div>

<p class="text-sm text-gray-500 text-center">
  Member since <%= user.createdAt.toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %>
</p>

<div class="flex justify-center mt-4 text-gray-600">
  <div class="flex items-center px-3 sm:px-5 gap-2 border-r <%= posts === 0 ? 'text-gray-400' : '' %>">
    <svg xmlns="http://w3.org" class="h-5 w-5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen">
      <title>Posts</title>
      <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
      <path d="M18.375 2.625a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z"/>
    </svg>
    <span><%= posts %></span>
  </div>
  <div class="flex items-center px-3 sm:px-5 gap-2 border-r <%= comments === 0 ? 'text-gray-400' : '' %>">
    <svg xmlns="http://w3.org" class="h-5 w-5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle">
      <title>Comments</title>
      <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
    </svg>
    <span><%= comments %></span>
  </div>
  <div class="flex items-center px-3 sm:px-5 gap-2 border-r <%= followers === 0 ? 'text-gray-400' : '' %>">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" width="1em" height="1em" viewBox="0 0 16 16"><title>Followers</title><path fill="currentColor" d="M15 14s1 0 1-1s-1-4-5-4s-5 3-5 4s1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276c.593.69.758 1.457.76 1.72l-.008.002l-.014.002zM11 7a2 2 0 1 0 0-4a2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0a3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4q0 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904c.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724c.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0a3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4a2 2 0 0 0 0-4"/></svg>
    <span><%= followers %></span>
  </div>
  <div class="flex items-center px-3 sm:px-5 gap-2 <%= following === 0 ? 'text-gray-400' : '' %>">
    <svg xmlns="http://w3.org" class="h-5 w-5" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <title>Following</title>
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
      <polyline points="16 11 18 13 22 9"/>
    </svg>
    <span><%= following %></span>
  </div>
</div>
