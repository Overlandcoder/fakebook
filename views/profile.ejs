<%- include("partials/header") %>

<main class="max-w-xl mx-auto py-8 px-4">
  <div class="flex flex-col justify-center mb-4 pt-2 p-4 bg-white shadow rounded-lg border hover:border-green-300 hover:shadow-md transition-all">
    <%- include("partials/user", { user: profileUser }) %>
  </div>

  <!-- POST SECTION -->
  <div class="mt-10">
    <% if (profileUser.posts.length > 0) { %>
      <% profileUser.posts.forEach(post => { %>
        <%- include("partials/post", { post: post }) %>
      <% }) %>
    <% } else { %>
      <div class="max-w-xl mx-auto py-10 rounded-xl bg-white text-center border border-gray-100 shadow-sm">
        <p class="text-gray-500 italic"><span class="font-semibold"><%= profileUser.username %></span> has no posts.</p>
      </div>
    <% } %>
  </div>
</main>

<%- include("partials/footer") %>
