<%- include("partials/header") %>

<main class="max-w-xl mx-auto py-12 px-4">
  <div class="bg-white border border-green-300 rounded-xl shadow-md shadow-green-100 overflow-hidden">
    <div class="border-b border-gray-100 p-2 sm:p-4 bg-green-600">
      <h2 class="text-lg sm:text-xl font-bold text-white text-center">Create Post</h2>
    </div>

    <% if (locals.error) { %>
      <div class="m-4 p-3 bg-red-50 border border-red-100 text-red-600 text-sm rounded-lg">
        <%= error %>
      </div>
    <% } %>

    <form action="/posts" method="POST" enctype="multipart/form-data" class="p-6">
      <div class="flex items-start gap-4 mb-7">
        <div class="flex-1">
          <label for="content" class="block text-sm font-semibold text-amber-600 mb-2 uppercase tracking-wider">What's on your mind?</label>
          <textarea name="content" id="content" rows="5" placeholder="Share your thoughts with the community!" class="w-full border border-amber-200 bg-amber-50/30 p-4 rounded-lg sm:text-lg focus:ring-0 outline-none resize-none placeholder:text-gray-300" required></textarea>
          <div class="flex mt-2 gap-2 items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-700/70" width="1em" height="1em" viewBox="0 0 16 16"><title xmlns="">card-image</title><g fill="currentColor"><path d="M6.002 5.5a1.5 1.5 0 1 1-3 0a1.5 1.5 0 0 1 3 0"/><path d="M1.5 2A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2zm13 1a.5.5 0 0 1 .5.5v6l-3.775-1.947a.5.5 0 0 0-.577.093l-3.71 3.71l-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12v.54L1 12.5v-9a.5.5 0 0 1 .5-.5z"/></g></svg>
            <input type="file" name="image" id="image" accept=".jpeg, .jpg, .png" class="file:px-4 file:py-2 file:mr-3.5 file:bg-amber-50 file:rounded-xl file:text-amber-700/80 text-sm file:text-base text-gray-500 hover:file:bg-amber-100 hover:file:text-amber-600 hover:file:cursor-pointer file:border-none file:transition-colors">
          </div>
        </div>
      </div>
      <div class="flex justify-between items-center">
        <a href="/" class="text-sm font-semibold hover:text-amber-500 text-gray-400 transition-colors">
          ← Cancel
        </a>
        <button type="submit" class="bg-green-600 text-white px-8 py-2 rounded-lg font-bold hover:bg-green-700 transition-colors shadow-sm active:scale-95">Post</button>
      </div>
    </form>
  </div>
</main>

<%- include("partials/footer") %>
